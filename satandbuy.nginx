server { server_name store.diginova.cm; location / { proxy_pass http://127.0.0.1:3000; proxy_set_header Host $host; } 
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/store.diginova.cm/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/store.diginova.cm/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server { server_name console.diginova.cm; location / { proxy_pass http://127.0.0.1:4000; proxy_set_header Host $host; } 
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/store.diginova.cm/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/store.diginova.cm/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server { server_name gateway.diginova.cm backend.diginova.cm; location / { proxy_pass http://127.0.0.1:5055; proxy_set_header Host $host; } 
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/store.diginova.cm/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/store.diginova.cm/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = store.diginova.cm) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

 listen 80; server_name store.diginova.cm;
    return 404; # managed by Certbot


}
server {
    if ($host = console.diginova.cm) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

 listen 80; server_name console.diginova.cm;
    return 404; # managed by Certbot


}
server {
    if ($host = backend.diginova.cm) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = gateway.diginova.cm) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

 listen 80; server_name gateway.diginova.cm backend.diginova.cm;
    return 404; # managed by Certbot




}
